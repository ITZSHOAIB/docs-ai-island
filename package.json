{
  "name": "docs-ai-island",
  "version": "0.0.0",
  "description": "A polished, framework-neutral AI handoff island for documentation sites.",
  "type": "module",
  "license": "MIT",
  "author": "Sohab Sk",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ITZSHOAIB/docs-ai-island.git"
  },
  "homepage": "https://github.com/ITZSHOAIB/docs-ai-island#readme",
  "bugs": {
    "url": "https://github.com/ITZSHOAIB/docs-ai-island/issues"
  },
  "keywords": [
    "documentation",
    "ai",
    "vitepress",
    "starlight",
    "docusaurus",
    "vocs",
    "widget"
  ],
  "scripts": {
    "dev": "pnpm --dir playground dev",
    "build": "pnpm clean && pnpm build:js && pnpm build:css",
    "build:js": "tsdown",
    "build:css": "lightningcss --bundle --sourcemap --minify src/styles/index.css -o dist/styles.css",
    "clean": "rimraf dist playground/dist coverage playwright-report test-results",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "test:e2e": "pnpm build && playwright test",
    "test:types": "tsc -p test-dts/tsconfig.json",
    "test:package": "pnpm build && publint --pack false --strict && rimraf .package && pnpm pack --pack-destination .package && attw .package/*.tgz --profile esm-only --entrypoints . && node scripts/check-package.mjs",
    "test:size": "pnpm build && size-limit",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:types && pnpm test:package && pnpm test:size",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build && changeset publish",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.8",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.0",
    "@playwright/test": "1.62.1",
    "@size-limit/file": "13.0.3",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "lightningcss-cli": "1.33.0",
    "publint": "0.3.23",
    "rimraf": "6.1.3",
    "simple-git-hooks": "2.13.1",
    "size-limit": "13.0.3",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint"
  },
  "size-limit": [
    {
      "name": "JavaScript",
      "path": "dist/index.js",
      "limit": "12 kB"
    },
    {
      "name": "CSS",
      "path": "dist/styles.css",
      "limit": "4 kB"
    }
  ]
}
